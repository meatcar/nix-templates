{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "vulnerabilityAlerts": {
    "enabled": true,
  },
  "osvVulnerabilityAlerts": true,
  "nix": {
    "enabled": true,
  },
  "lockFileMaintenance": {
    "enabled": true,
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
    },
    {
      // NOTE: versions must match nixpkgs.
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@playwright/**", "bun", "@types/bun"],
      "enabled": false,
    },
  ],
}
