{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // NOTE: after bootstrap-automerge.sh, opt in to github>meatcar/renovate-config:automerge
  // when that preset is published. See README.md; it is not required yet.
  "extends": ["github>meatcar/renovate-config"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
    },
    {
      // NOTE: versions must match nixpkgs.
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@playwright/**", "playwright", "playwright-core", "bun", "@types/bun"],
      "enabled": false,
    },
  ],
}
