  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "latest",
    "fallow": "^3.0.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
